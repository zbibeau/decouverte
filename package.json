{
  "name": "demo-ventes",
  "scripts": {
    "dev": "vinxi dev --port 3100",
    "build": "vinxi build",
    "build:static": "BUILD=static vinxi build",
    "start": "node ./.output/server/index.mjs",
    "lint": "eslint src --ext .ts,.tsx --fix",
    "lint:type": "tsc --project tsconfig.json && eslint src --ext .ts,.tsx --fix",
    "prepare": "husky install",
    "supabase": "pnpm dlx supabase@latest",
    "supabase:start": "pnpm dlx supabase@latest start",
    "supabase:stop": "pnpm dlx supabase@latest stop",
    "supabase:reset": "pnpm dlx supabase@latest db reset",
    "supabase:status": "pnpm dlx supabase@latest status",
    "content:push": "node scripts/content-push.mjs",
    "content:diff": "node scripts/content-push.mjs --dry-run"
  },
  "type": "module",
  "lint-staged": {
    "*.{ts,tsx,json,scss,css,md}": "prettier --write --ignore-unknown"
  },
  "pnpm": {
    "overrides": {
      "braces@<3.0.3": ">=3.0.3",
      "rollup@>=4.0.0 <4.22.4": ">=4.22.4",
      "path-to-regexp@>=4.0.0 <6.3.0": ">=6.3.0",
      "cross-spawn@>=7.0.0 <7.0.5": ">=7.0.5",
      "dset@<3.1.4": ">=3.1.4"
    }
  },
  "devDependencies": {
    "@commitlint/cli": "^19.3.0",
    "@graphql-codegen/cli": "^5.0.2",
    "@graphql-codegen/typescript": "^4.0.7",
    "@graphql-codegen/typescript-operations": "^4.2.1",
    "@types/js-cookie": "^3.0.6",
    "@types/lodash": "^4.17.4",
    "@typescript-eslint/eslint-plugin": "^7.10.0",
    "@typescript-eslint/parser": "^7.10.0",
    "@vitejs/plugin-legacy": "^5.4.1",
    "autoprefixer": "^10.4.19",
    "conventional-changelog-angular": "^8.0.0",
    "eslint-config-prettier": "^10.0.0",
    "eslint-import-resolver-typescript": "^3.6.1",
    "eslint-plugin-jsx-a11y": "^6.8.0",
    "eslint-plugin-prettier": "^5.1.3",
    "eslint-plugin-simple-import-sort": "^12.1.0",
    "eslint-plugin-solid": "^0.14.0",
    "husky": "^9.0.11",
    "lint-staged": "^15.2.4",
    "lodash": "^4.17.21",
    "pg": "^8.13.0",
    "postcss": "^8.4.38",
    "prettier-plugin-tailwindcss": "^0.6.0",
    "sass": "^1.77.2",
    "solid-devtools": "^0.33.0",
    "tailwindcss": "^3.4.3",
    "terser": "^5.31.0",
    "typescript": "^5.4.5",
    "unplugin-imagemin": "^0.5.18",
    "vinxi": "^0.3.11",
    "vite-multiple-assets": "^2.0.0"
  },
  "dependencies": {
    "@ark-ui/solid": "4.1.0",
    "@commitlint/config-conventional": "^19.2.2",
    "@dotlottie/player-component": "^2.7.12",
    "@modular-forms/solid": "^0.23.0",
    "@solid-primitives/clipboard": "^1.5.10",
    "@solid-primitives/intersection-observer": "^2.1.6",
    "@solid-primitives/resize-observer": "^2.0.25",
    "@solid-primitives/scheduled": "^1.4.3",
    "@solid-primitives/script-loader": "^2.1.2",
    "@solid-primitives/scroll": "^2.0.23",
    "@solid-primitives/share": "^2.0.6",
    "@solidjs/meta": "^0.29.4",
    "@solidjs/router": "^0.14.0",
    "@solidjs/start": "^1.0.6",
    "@supabase/supabase-js": "^2.102.1",
    "@tanstack/solid-query": "^5.37.1",
    "@tanstack/solid-query-devtools": "^5.37.1",
    "classix": "^2.1.37",
    "date-fns": "^4.0.0",
    "eslint-plugin-import": "^2.31.0",
    "eslint-plugin-tailwindcss": "^3.16.0",
    "fets": "^0.8.0",
    "graphql": "^16.8.1",
    "js-cookie": "^3.0.5",
    "media-icons": "^1.1.4",
    "nanoid": "^5.0.7",
    "remixicon": "^4.2.0",
    "rosetty": "^3.0.55",
    "rosetty-solid": "^2.0.114",
    "solid-js": "1.9.4",
    "solid-textarea-autosize": "^0.0.5",
    "solid-transition-group": "0.3.0",
    "typescript-solid-query": "^1.0.0",
    "vidstack": "1.12.12",
